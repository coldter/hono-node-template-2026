{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"],
    "noUnusedLocals": false
  },
  "include": ["src", "tests"],
  "exclude": ["**/node_modules", "**/dist", "**/.*/"]
}
