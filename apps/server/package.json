{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo --noEmit",
    "check-types:backup": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seeds/index.ts",
    "seed:audit-logs": "tsx scripts/seeds/audit-logs/run.ts",
    "vault:debug": "tsx scripts/vault-debug.ts",
    "push:debug": "tsx scripts/push-debug.ts",
    "generate-openapi": "tsx scripts/generate-openapi.ts",
    "db:mm:up": "drizzle-kit up",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "1.14.0",
    "@hono/node-server": "^2.0.4",
    "@hono/otel": "^1.1.2",
    "@hono/zod-openapi": "^1.4.0",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/winston-transport": "^0.29.0",
    "@repo/authorization": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.3",
    "better-auth": "^1.6.18",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "firebase-admin": "^14.0.0",
    "hono": "^4.12.25",
    "hono-rate-limiter": "^0.5.3",
    "itty-time": "^2.0.2",
    "pg": "^8.21.0",
    "pg-error-enum": "^2.0.1",
    "rate-limit-redis": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "redis": "^6.0.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@inquirer/prompts": "^8.5.2",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@typescript/native-preview": "beta",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^1.0.0-rc.4-ca0f029",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
