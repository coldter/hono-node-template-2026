{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsgo --noEmit",
    "check-types:backup": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seeds/index.ts",
    "seed:dev": "tsx scripts/seeds/dev/run.ts",
    "seed:audit-logs": "tsx scripts/seeds/audit-logs/run.ts",
    "vault:debug": "tsx scripts/vault-debug.ts",
    "push:debug": "tsx scripts/push-debug.ts",
    "generate-openapi": "tsx scripts/generate-openapi.ts || true",
    "db:mm:up": "drizzle-kit up",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@better-auth/sso": "^1.6.10",
    "@hatchet-dev/typescript-sdk": "1.14.0",
    "@hono/node-server": "^2.0.2",
    "@hono/otel": "^1.1.2",
    "@hono/zod-openapi": "^1.4.0",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.217.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.217.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@repo/auth-tokens": "workspace:*",
    "@repo/authorization": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/hono-app": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/tenancy": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.14",
    "better-auth": "^1.6.10",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.2-e38a2ba",
    "firebase-admin": "^13.9.0",
    "hono": "^4.12.18",
    "hono-rate-limiter": "^0.5.3",
    "itty-time": "^2.0.2",
    "pg": "^8.20.0",
    "pg-error-enum": "^2.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "redis": "^5",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/memory-adapter": "^1.6.10",
    "@faker-js/faker": "^10.4.0",
    "@inquirer/prompts": "^8.4.3",
    "@repo/test-harness": "workspace:*",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@typescript/native-preview": "beta",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^1.0.0-rc.2-e38a2ba",
    "jose": "^6.2.3",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
