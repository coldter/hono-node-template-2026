{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:mm:up": "drizzle-kit up",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seeds/index.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch src/index.ts",
    "generate-openapi": "tsx scripts/generate-openapi.ts",
    "push:debug": "tsx scripts/push-debug.ts",
    "seed:audit-logs": "tsx scripts/seeds/audit-logs/run.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "vault:debug": "tsx scripts/vault-debug.ts"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "1.14.0",
    "@hono/node-server": "^2.1.1",
    "@hono/otel": "^1.1.2",
    "@hono/zod-openapi": "^1.6.1",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@node-rs/argon2": "^2.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/winston-transport": "^0.31.0",
    "@repo/authorization": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.0",
    "better-auth": "^1.7.2",
    "chalk": "^6.0.0",
    "cli-highlight": "^2.1.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "firebase-admin": "^14.3.0",
    "hono": "^4.13.5",
    "hono-rate-limiter": "^0.5.3",
    "itty-time": "^2.0.2",
    "pg": "^8.23.0",
    "pg-error-enum": "^2.0.1",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.1",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@inquirer/prompts": "^8.7.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
