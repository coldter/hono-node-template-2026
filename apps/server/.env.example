# App
NODE_ENV="development"
PORT="3000"
APP_NAME="App"
COMPANY_NAME="Acme Inc."
SUPPORT_EMAIL="support@example.com"
# Winston levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL="info"
ENABLE_DOCS="true"
# Escape hatch to expose OpenAPI docs in production.
ENABLE_DOCS_IN_PRODUCTION="false"
# BASE_PATH="/api"
SERVER_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3001"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DATABASE_TEST_URL="postgresql://postgres:postgres@localhost:5432/starter-test-db"
# Max pg pool connections. Size against HATCHET_WORKER_SLOTS: co-located
# workflow tasks share this pool with HTTP requests.
DB_POOL_MAX="10"

# Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Redis
REDIS_URL="redis://default@localhost:6379"

# Hatchet Background Jobs
# Lite (recommended for local dev): docker compose -f ../../compose.hatchet.yaml up -d
#   Dashboard: http://localhost:8888  gRPC: localhost:7077
#   Default login: admin@example.com / Admin123!! -> create tenant -> generate token
# Full (production-like): docker compose -f ../../compose.hatchet.full.yaml up -d (dashboard 9090)
# Docs: https://docs.hatchet.run/self-hosting/hatchet-lite
HATCHET_ENABLED="false"
HATCHET_CLIENT_TOKEN=""
HATCHET_CLIENT_TLS_STRATEGY="none"
HATCHET_CLIENT_HOST_PORT="localhost:7077"
HATCHET_CLIENT_API_URL="http://localhost:8888"
HATCHET_CLIENT_NAMESPACE=""
HATCHET_WORKER_SLOTS="10"
HATCHET_THROW_ON_ERROR="false"
WORK_FLOWS_LOG_LEVEL="warn"

# Email
# For local dev with Mailpit: docker compose -f compose.extra.yaml up -d
# Then access Web UI at http://localhost:8026
EMAIL_PROVIDER="nodemailer"
EMAIL_FROM="noreply@localhost"
EMAIL_FROM_NAME="App"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER="any"
SMTP_PASS="any"
SMTP_SECURE="false"

# Firebase Cloud Messaging
# Set FCM_PROVIDER=firebase and provide base64-encoded service account JSON to enable push delivery
FCM_PROVIDER="console"
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=""

# ========================================
# OpenTelemetry Configuration
# ========================================
OTEL_ENABLED=false

# Separate endpoints for each signal (configure only what you need).
# Each pipeline starts independently: a missing endpoint disables only that
# signal (warned at boot). With OTEL_ENABLED=true and no endpoints at all,
# the SDK is skipped entirely outside development.
# Axiom:  https://api.axiom.co/v1/traces
# Jaeger: http://localhost:4318/v1/traces
OTEL_TRACES_ENDPOINT=

# Axiom:      https://api.axiom.co/v1/metrics
# Prometheus: http://localhost:4318/v1/metrics
OTEL_METRICS_ENDPOINT=

# Winston logs are exported via OTLP only when this is set.
# Axiom: https://api.axiom.co/v1/logs
# Loki:  http://localhost:4318/v1/logs
OTEL_LOGS_ENDPOINT=

# Shared headers used by all OTLP exporters, in the OTEL-standard
# comma-separated key=value format:
#   Authorization=Bearer xaat-xxx,X-Axiom-Dataset=my-dataset
# A JSON object is also accepted for backward compatibility:
#   {"Authorization":"Bearer xaat-xxx","X-Axiom-Dataset":"my-dataset"}
OTEL_EXPORTER_OTLP_HEADERS=

# ========================================
# Vault - Encryption for Sensitive Data
# ========================================
# Providers: local, aws-kms, gcp-kms, azure-keyvault
VAULT_PROVIDER="local"

# generate `VAULT_MASTER_KEY` using: `openssl rand -hex 32`
VAULT_MASTER_KEY=""

# OAuth Social Login (optional - add providers as needed via better-auth)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Set to true when deployed behind a trusted reverse proxy (Caddy).
# Rate limiting then keys on the rightmost X-Forwarded-For entry.
TRUST_PROXY=false

# Optional. When set, Better Auth and the global rate limiter store counters
# in Redis (required for multi-instance deployments).
# REDIS_URL=redis://localhost:6379

# Self-serve sign-up. Default false (invite-only).
ENABLE_SIGNUP=true
