{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"],
    "jsx": "react-jsx",
    "noUnusedLocals": false
  },
  "include": ["src", "tests", "mocks", "scripts"],
  "exclude": ["**/node_modules", "**/dist", "**/.*/"]
}
