{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"],
    "jsx": "react-jsx",
    "noUnusedLocals": false
  },
  "include": ["src", "tests", "mocks", "scripts"],
  "exclude": ["**/node_modules", "**/dist", "**/.*/"]
}
