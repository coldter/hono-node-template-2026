{
  "name": "repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:storybook": "turbo -F web build-storybook",
    "check": "ultracite check",
    "check-types": "turbo check-types",
    "clean": "rm -rf .turbo && git clean -xdf node_modules apps/*/node_modules && rm -f bun.lock",
    "db:generate": "turbo -F server db:generate",
    "db:migrate": "turbo -F server db:migrate",
    "db:push": "turbo -F server db:push",
    "db:studio": "turbo -F server db:studio",
    "dev": "turbo dev --filter=!@repo/email",
    "dev:email": "turbo -F @repo/email dev",
    "dev:server": "turbo -F server dev",
    "dev:storybook": "turbo -F web storybook",
    "dev:web": "turbo -F web dev",
    "fix": "ultracite fix",
    "format": "biome format --write",
    "generate-openapi": "turbo -F server generate-openapi",
    "postinstall": "test -f apps/server/openapi.cache.json || turbo -F server generate-openapi",
    "knip": "SKIP_ENV_VALIDATION=true knip -c knip.config.ts",
    "knip:fix": "knip --fix -c knip.config.ts -W apps/web",
    "preview:web": "turbo -F web preview",
    "template:init": "bun scripts/init-template.ts",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:watch": "turbo test:watch",
    "update:deps": "bunx taze major -w -r --ignore-other-workspaces"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.4.0",
    "knip": "^6.33.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.7"
  },
  "packageManager": "bun@1.4.0"
}
