{
  "name": "repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "format": "biome format --write",
    "dev": "turbo dev --filter=!@repo/email",
    "build": "turbo build",
    "clean": "rm -rf .turbo && git clean -xdf node_modules apps/*/node_modules && rm bun.lock",
    "check-types": "turbo check-types",
    "check-types:backup": "turbo check-types:backup",
    "dev:admin-ui": "turbo -F admin-ui dev",
    "preview:admin-ui": "turbo -F admin-ui preview",
    "dev:server": "turbo -F server dev",
    "dev:email": "turbo -F @repo/email dev",
    "dev:storybook": "turbo -F admin-ui storybook",
    "build:storybook": "turbo -F admin-ui build-storybook",
    "db:push": "turbo -F server db:push",
    "db:studio": "turbo -F server db:studio",
    "db:generate": "turbo -F server db:generate",
    "db:migrate": "turbo -F server db:migrate",
    "seed:dev": "turbo -F server seed:dev",
    "seed:operator": "turbo -F admin-server seed:operator",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test:coverage",
    "knip": "SKIP_ENV_VALIDATION=true knip -c knip.config.ts",
    "knip:fix": "knip --fix -c knip.config.ts -W apps/admin-ui",
    "update:deps": "bunx taze major -w -r --ignore-other-workspaces",
    "generate-openapi": "turbo -F server generate-openapi",
    "postinstall": "test -f apps/server/openapi.cache.json || turbo -F server generate-openapi",
    "template:init": "bun scripts/init-template.ts",
    "setup:env": "bun run scripts/setup-env.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "knip": "^6.14.1",
    "tsx": "^4.22.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "ultracite": "^7.7.0"
  },
  "packageManager": "bun@1.3.14"
}
