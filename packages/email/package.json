{
  "name": "@repo/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./templates/*": "./src/templates/*"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "check-types": "tsgo --noEmit",
    "check-types:backup": "tsc --noEmit",
    "dev": "email dev --dir ./src/templates --port 3003"
  },
  "dependencies": {
    "@react-email/components": "^1.0.11",
    "@react-email/render": "^2.0.7",
    "nodemailer": "^8.0.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-email": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "beta",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
