    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
