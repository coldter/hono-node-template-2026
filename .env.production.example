# ===========================================
# Production Environment Variables
# ===========================================
# Copy this to .env.production and fill in values.
# DO NOT commit .env.production to git.

# App
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
APP_NAME=CHANGE_ME_app_name
COMPANY_NAME=CHANGE_ME_company_name
SUPPORT_EMAIL=CHANGE_ME_support_email
ENABLE_DOCS=false
# Escape hatch to expose OpenAPI docs in production.
ENABLE_DOCS_IN_PRODUCTION=false
CORS_ORIGIN=https://your-app.example.com
BASE_PATH=
SERVER_URL=https://your-api.example.com
APP_URL=https://your-app.example.com

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_password_here@db:5432/postgres

# Auth
BETTER_AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
BETTER_AUTH_URL=https://your-api.example.com

# Encryption
VAULT_PROVIDER=local
VAULT_MASTER_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64_chars

# Email
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=noreply@your-app.example.com
EMAIL_FROM_NAME=CHANGE_ME_app_name
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=any
SMTP_PASS=any
SMTP_SECURE=false

# Redis
REDIS_URL=redis://default@redis:6379

# Hatchet
# After first deploy, get token from hatchet-dashboard or config volume
HATCHET_ENABLED=false
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TLS_STRATEGY=none
HATCHET_CLIENT_HOST_PORT=hatchet-engine:7070
HATCHET_WORKER_SLOTS=10
HATCHET_THROW_ON_ERROR=false
WORK_FLOWS_LOG_LEVEL=warn

# Push Notifications (FCM)
# Set FCM_PROVIDER=firebase and provide base64-encoded service account JSON to enable push delivery
FCM_PROVIDER=console
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# Observability (optional)
OTEL_ENABLED=false
OTEL_TRACES_ENDPOINT=
OTEL_METRICS_ENDPOINT=
OTEL_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Caddy Domains
API_DOMAIN=your-api.example.com
APP_DOMAIN=your-app.example.com
MAIL_DOMAIN=mail.your-app.example.com
HATCHET_DASHBOARD_DOMAIN=hatchet.your-app.example.com

# Web (build-time only - baked into JS bundle)
VITE_SERVER_URL=https://your-api.example.com
VITE_APP_NAME=CHANGE_ME_app_name
VITE_COMPANY_NAME=CHANGE_ME_company_name
VITE_SUPPORT_EMAIL=CHANGE_ME_support_email
