{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "linter": { "enabled": false }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!bun.lock",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/dev-dist",
      "!**/.zed",
      "!**/.vscode",
      "!**/routeTree.gen.ts",
      "!**/src-tauri",
      "!**/.nuxt",
      "!bts.jsonc",
      "!**/.expo",
      "!**/.wrangler",
      "!**/.alchemy",
      "!**/wrangler.jsonc",
      "!**/.source",
      "!**/api.gen",
      "!agent-ref/**/*",
      "!tsconfig.json",
      "bun.lock",
      "!openapi.cache.json",
      "!apps/server/openapi.cache.json",
      "!packages/db/src/migrations/**/*",
      "!.agents/**/*",
      "!.claude/**/*"
    ]
  },
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "linter": {
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off",
        "noNoninteractiveElementInteractions": "off"
      },
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error", "info", "warn"]
          }
        },
        "noUnknownAtRules": "off",
        "noEmptyBlockStatements": "off",
        "useAwait": "off",
        "noExplicitAny": "error",
        "noDocumentCookie": "error",
        "noArrayIndexKey": "off"
      },
      "performance": {
        "noNamespaceImport": "off",
        "noBarrelFile": "off"
      },
      "style": {
        "noMagicNumbers": "off",
        "noExportedImports": "off",
        "noNonNullAssertion": "warn",
        "useConsistentTypeDefinitions": "off",
        "useAtIndex": "off",
        "useFilenamingConvention": {
          "level": "warn",
          "options": {
            "filenameCases": ["kebab-case", "camelCase"]
          }
        }
      },
      "nursery": {
        "noUnnecessaryConditions": "off",
        "useSortedClasses": "off",
        "noLeakedRender": "off",
        "noShadow": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "correctness": {
        "useImportExtensions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/email/src/components/**/*.tsx",
        "packages/email/src/templates/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/**/*.ts",
        "!apps/server/src/**/__tests__/**",
        "!apps/server/src/**/*.test.ts",
        "!apps/server/src/**/*.spec.ts",
        "apps/admin-server/src/**/*.ts",
        "!apps/admin-server/src/**/__tests__/**",
        "!apps/admin-server/src/**/*.test.ts",
        "!apps/admin-server/src/**/*.spec.ts",
        "packages/auth-tokens/src/**/*.ts",
        "!packages/auth-tokens/src/**/__tests__/**",
        "packages/authorization/src/**/*.ts",
        "!packages/authorization/src/**/__tests__/**",
        "packages/db/src/**/*.ts",
        "!packages/db/src/**/__tests__/**",
        "packages/email/src/**/*.{ts,tsx}",
        "!packages/email/src/**/__tests__/**",
        "packages/shared/src/**/*.ts",
        "!packages/shared/src/**/__tests__/**",
        "packages/tenancy/src/**/*.ts",
        "!packages/tenancy/src/**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@repo/test-harness": "Production code must not import @repo/test-harness; it is a dev-only fixtures package.",
                  "@repo/test-harness/seed-tenant": "Production code must not import @repo/test-harness; it is a dev-only fixtures package.",
                  "@repo/test-harness/oidc/fake-idp": "Production code must not import @repo/test-harness; it is a dev-only fixtures package.",
                  "@repo/test-harness/caddy-stub": "Production code must not import @repo/test-harness; it is a dev-only fixtures package."
                }
              }
            }
          }
        }
      }
    }
  ]
}
