{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["bun.lock"],
  "globalEnv": ["SKIP_ENV_VALIDATION", "DEV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["VITE_*", "NODE_ENV"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json", "../../tsconfig*.json"],
      "outputs": []
    },
    "check-types:backup": {
      "dependsOn": ["^check-types:backup"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json", "../../tsconfig*.json"],
      "outputs": []
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".storybook/**"],
      "outputs": ["storybook-static/**"],
      "env": ["VITE_*", "NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "persistent": true
    },
    "generate-openapi": {
      "cache": true,
      "outputs": ["openapi.cache.json"],
      "env": ["DATABASE_URL", "BETTER_AUTH_SECRET", "SKIP_ENV_VALIDATION"]
    },
    "generate-client": {
      "cache": false
    },
    "test": {
      "cache": false,
      "env": ["DATABASE_TEST_URL"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_TEST_URL"]
    },
    "test:coverage": {
      "cache": false,
      "env": ["DATABASE_TEST_URL"]
    }
  }
}
