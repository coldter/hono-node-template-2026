{$API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	reverse_proxy server:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			dial_timeout 10s
			response_header_timeout 60s
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

{$MAIL_DOMAIN} {
	encode zstd gzip
	reverse_proxy mailpit:8025
}

{$HATCHET_DASHBOARD_DOMAIN} {
	encode zstd gzip
	reverse_proxy hatchet-dashboard:80
}

{$APP_DOMAIN} {
	encode zstd gzip
	root * /srv/web

	# Content-hashed Vite assets never change; cache them aggressively.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Everything else (notably index.html) must revalidate so new deploys are
	# picked up immediately.
	@dynamic not path /assets/*
	header @dynamic Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
